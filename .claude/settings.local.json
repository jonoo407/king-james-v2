{
  "permissions": {
    "allow": [
      "Bash(gh auth *)",
      "Bash(gh api *)",
      "Bash(gh repo *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-tests.sh",
            "if": "Bash(git commit*)",
            "timeout": 60,
            "statusMessage": "TDD gate: running unit + QC suites…"
          }
        ]
      }
    ]
  }
}
